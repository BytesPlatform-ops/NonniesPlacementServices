# SMTP for website form submissions (Google Workspace).
# Copy to `.env` (or `.env.local`) and fill in a real Gmail App Password.
# NEVER commit real credentials — .env and .env*.local are gitignored.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@nonnisplacement.com
SMTP_PASS=GOOGLE_APP_PASSWORD_HERE
FORM_TO=admin@nonnisplacement.com

# Server-to-server base URL of the Nonni's platform (NestJS) backend. Used BOTH
# for additive form-submission persistence AND for fetching public website
# content (blog, short videos, testimonials). Server-only — never exposed to the
# browser. May include or omit a trailing slash and/or an `/api/v1` suffix; the
# website normalizes it. In DEVELOPMENT, if unset it falls back to
# http://localhost:4000 automatically. In PRODUCTION it is REQUIRED.
NONNIS_PLATFORM_API_URL=https://your-backend.example.com

# Shared server-only token for form-submission ingestion (not used by public
# content reads, which are unauthenticated). Never public.
NONNIS_INGEST_TOKEN=SHARED_SERVER_ONLY_INGEST_TOKEN
