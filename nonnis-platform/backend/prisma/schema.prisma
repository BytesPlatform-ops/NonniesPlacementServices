// Nonnis Digital Optimization Platform — relational foundation.
//
// The central business object is the DISCHARGE CASE. Everything is modelled
// around a case and its movement through the discharge workflow. All primary
// keys are stable UUIDs — never email, name, phone, or an external id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through the Supabase transaction-mode pooler (pgbouncer).
  url       = env("DATABASE_URL")
  // Migrations use the Supabase session-mode pooler / direct connection.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// The kind of organization a record represents. Extensible for every partner
/// type the network will eventually hold.
enum OrganizationType {
  NONNIS
  HOSPITAL
  REHABILITATION_CENTER
  SKILLED_NURSING_FACILITY
  PROVIDER
  PARTNER
}

/// Lifecycle of a discharge case. Transitions are recorded as WorkflowEvents —
/// status is never meaningfully changed without a corresponding event.
enum CaseStatus {
  DRAFT
  READY_FOR_REVIEW
  MATCHING
  REFERRAL_SENT
  PROVIDER_REVIEWING
  ADDITIONAL_INFORMATION_REQUIRED
  ACCEPTED
  DECLINED
  SERVICES_BEING_COORDINATED
  READY_FOR_DISCHARGE
  DISCHARGED
  SERVICE_STARTED
  FOLLOW_UP_REQUIRED
  COMPLETED
  CANCELLED
}

/// Where the patient currently is at the time of the case.
enum CareSetting {
  HOSPITAL
  REHABILITATION_CENTER
  SKILLED_NURSING_FACILITY
  EMERGENCY_DEPARTMENT
  HOME
  ASSISTED_LIVING
  MEMORY_CARE
  OTHER
}

/// High-level category of a requested post-discharge service. Retained as a
/// stable enum on ServiceRequest; the admin-managed ServiceCategory model
/// (whose `code` mirrors these values) is the forward-looking source of truth.
enum ServiceCategoryCode {
  HOME_HEALTH
  SKILLED_NURSING
  PHYSICAL_THERAPY
  OCCUPATIONAL_THERAPY
  SPEECH_THERAPY
  PERSONAL_CARE
  HOMEMAKER
  HOSPICE
  PALLIATIVE_CARE
  INFUSION
  WOUND_CARE
  BEHAVIORAL_HEALTH
  DURABLE_MEDICAL_EQUIPMENT
  TRANSPORTATION
  OTHER
}

/// Level of care / support intensity for a service request.
enum LevelOfCare {
  INDEPENDENT
  SUPPORTIVE
  INTERMEDIATE
  SKILLED
  COMPLEX
}

/// Lifecycle of an individual service request within a case.
enum ServiceRequestStatus {
  REQUESTED
  MATCHING
  FULFILLED
  CANCELLED
}

/// Category of a discrete case requirement / constraint.
enum RequirementCategory {
  CLINICAL
  NONCLINICAL
  EQUIPMENT
  TRANSPORTATION
  PROVIDER_QUALIFICATION
  INSURANCE_FUNDING
  SPECIAL_CIRCUMSTANCE
  PREFERENCE
}

/// Business workflow event types. Append-only history for a case.
enum WorkflowEventType {
  CASE_CREATED
  CASE_UPDATED
  STATUS_CHANGED
  CASE_ASSIGNED
  CASE_REASSIGNED
  CASE_UNASSIGNED
  REQUIREMENT_ADDED
  REQUIREMENT_UPDATED
  REQUIREMENT_STATUS_CHANGED
  SERVICE_REQUEST_ADDED
  SERVICE_REQUEST_UPDATED
  SERVICE_REQUEST_REMOVED
  NOTE_ADDED
  CASE_CANCELLED
  PROVIDER_SELECTION_STARTED
  REFERRAL_CREATED
  REFERRAL_SENT
  REFERRAL_VIEWED
  REFERRAL_INFORMATION_REQUESTED
  REFERRAL_INFORMATION_PROVIDED
  REFERRAL_CONDITIONALLY_ACCEPTED
  REFERRAL_ACCEPTED
  REFERRAL_DECLINED
  REFERRAL_WITHDRAWN
  REFERRAL_NOTIFICATION_SENT
  REFERRAL_NOTIFICATION_FAILED
  PLACEMENT_CREATED
  SERVICE_START_SCHEDULED
  SERVICE_STARTED
  SERVICE_START_UNSUCCESSFUL
  TASK_CREATED
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_STARTED
  TASK_COMPLETED
  TASK_CANCELLED
  TASK_UPDATED
  CASE_MESSAGE_SENT
  PROVIDER_MESSAGE_SENT
  INTERNAL_NOTE_ADDED
}

/// Lifecycle of a discrete case requirement.
enum RequirementStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETE
  NOT_REQUIRED
}

/// Whether a workflow event was produced by a human, an automation, or the
/// system itself.
enum WorkflowEventSource {
  MANUAL
  AUTOMATED
  SYSTEM
}

/// Lifecycle of an application user. Supabase Auth owns credentials; this is
/// the Nonnis application identity state.
enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// Lifecycle of a user's membership within an organization.
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

/// Active-state of an organization.
enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

/// Active-state of a facility.
enum FacilityStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Core domain
// ---------------------------------------------------------------------------

/// A participating organization — Nonnis itself, a discharging facility's
/// parent org, a provider org, or another partner.
model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  type        OrganizationType
  status      OrganizationStatus @default(ACTIVE)
  name        String
  legalName   String?
  /// External reference (e.g. partner/EHR org id). Never used as a primary key.
  externalRef String?
  /// Extensible, non-workflow-critical metadata only.
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  facilities     Facility[]
  patients       Patient[]
  cases          Case[]
  memberships    OrganizationMembership[]
  workflowEvents WorkflowEvent[]
  auditEvents    AuditEvent[]
  /// A provider organization has exactly one operational provider profile.
  provider       Provider?

  @@index([type])
  @@index([status])
  @@map("organizations")
}

/// A physical facility belonging to an organization. Discharge cases originate
/// from a facility.
model Facility {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  status         FacilityStatus @default(ACTIVE)
  name           String
  externalRef    String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?        @default("US")
  phone          String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cases        Case[]

  @@index([organizationId])
  @@map("facilities")
}

/// A patient who may have multiple discharge cases over time. Deliberately not
/// embedded inside Case. Minimal identifying data only — not a medical record.
model Patient {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  firstName      String
  lastName       String
  dateOfBirth    DateTime? @db.Date
  /// External reference (e.g. facility MRN). Never used as a primary key.
  externalRef    String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cases        Case[]

  @@index([organizationId])
  @@map("patients")
}

/// The central discharge case.
model Case {
  id             String     @id @default(uuid()) @db.Uuid
  /// Human-readable internal case identifier (unique).
  caseNumber     String     @unique
  /// Optional external facility/EHR case id.
  externalCaseId String?
  status         CaseStatus @default(DRAFT)

  organizationId        String @db.Uuid
  patientId             String @db.Uuid
  originatingFacilityId String @db.Uuid

  /// Legacy placeholder reference retained for backward compatibility; the
  /// relational `assignedDischargeProfessionalId` below is authoritative.
  dischargeProfessionalRef String?

  /// Authenticated discharge professional (User) assigned to this case.
  assignedDischargeProfessionalId String? @db.Uuid

  expectedDischargeDate DateTime?
  actualDischargeDate   DateTime?
  currentCareSetting    CareSetting?

  /// Destination / preferred service location (free-form for now; structured
  /// geographic constraints live on ServiceRequest).
  preferredServiceLocation String?

  // Communication / accessibility.
  primaryLanguage         String?
  interpreterRequired     Boolean  @default(false)
  communicationPreference String?
  accessibilityNeeds      String[]

  // Patient contact & authorized representative.
  patientContactPhone        String?
  representativeName         String?
  representativeRelationship String?
  representativeContact      String?

  // Manual blocked flag (contributes to case attention).
  blocked     Boolean @default(false)
  blockReason String?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization                  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient                       Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  originatingFacility           Facility          @relation(fields: [originatingFacilityId], references: [id], onDelete: Restrict)
  assignedDischargeProfessional User?             @relation("CaseAssignedProfessional", fields: [assignedDischargeProfessionalId], references: [id], onDelete: SetNull)
  requirements                  CaseRequirement[]
  serviceRequests               ServiceRequest[]
  workflowEvents                WorkflowEvent[]
  referrals                     Referral[]
  tasks                         Task[]
  messages                      Message[]

  @@index([organizationId])
  @@index([patientId])
  @@index([originatingFacilityId])
  @@index([assignedDischargeProfessionalId])
  @@index([status])
  @@index([updatedAt])
  @@map("cases")
}

/// A requested post-discharge service tied to a case.
model ServiceRequest {
  id     String               @id @default(uuid()) @db.Uuid
  caseId String               @db.Uuid
  status ServiceRequestStatus @default(REQUESTED)

  category           ServiceCategoryCode
  levelOfCare        LevelOfCare?
  requestedStartDate DateTime?

  /// Forward-looking link to the admin-managed ServiceCategory catalog. Nullable
  /// and additive: the `category` enum above remains the current source of truth
  /// until data is backfilled in a later slice.
  serviceCategoryId String? @db.Uuid
  frequency         String?
  durationText      String?

  // Geographic requirements.
  serviceCity        String?
  serviceState       String?
  servicePostalCode  String?
  serviceRadiusMiles Int?

  // Insurance / funding.
  fundingSource          String?
  insurancePlan          String?
  authorizationReference String?

  // Additional matching inputs (used by future matching; captured now).
  requiredQualifications String?
  mandatoryLanguage      String?
  equipmentNeeds         String?
  transportationRequired Boolean @default(false)

  notes     String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case            Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requirements    CaseRequirement[]
  serviceCategory ServiceCategory?  @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  referrals       Referral[]

  @@index([caseId])
  @@index([category])
  @@index([serviceCategoryId])
  @@map("service_requests")
}

/// A discrete requirement or constraint on a case, optionally scoped to a
/// specific service request.
model CaseRequirement {
  id                String              @id @default(uuid()) @db.Uuid
  caseId            String              @db.Uuid
  serviceRequestId  String?             @db.Uuid
  category          RequirementCategory
  status            RequirementStatus   @default(PENDING)
  label             String
  detail            String?
  mandatory         Boolean             @default(true)
  dueDate           DateTime?
  notes             String?
  completedAt       DateTime?
  completedByUserId String?             @db.Uuid
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  case           Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  completedBy    User?           @relation("RequirementCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([serviceRequestId])
  @@index([category])
  @@index([status])
  @@map("case_requirements")
}

/// Append-only business workflow history for a case (timelines, analytics,
/// automation, auditability).
model WorkflowEvent {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  caseId         String              @db.Uuid
  type           WorkflowEventType
  previousStatus CaseStatus?
  newStatus      CaseStatus?
  /// Legacy free-form actor reference, retained for backward compatibility.
  actorRef       String?
  /// Authenticated user responsible for this event (null for automated/system).
  actorUserId    String?             @db.Uuid
  source         WorkflowEventSource @default(SYSTEM)
  metadata       Json?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([organizationId])
  @@index([actorUserId])
  @@index([type])
  @@index([createdAt])
  @@map("workflow_events")
}

/// Append-only security / admin action history. Distinct from WorkflowEvent
/// (which is business workflow history). Never store secrets in metadata.
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  /// Legacy free-form actor reference, retained for backward compatibility.
  actorRef       String?
  /// Authenticated user who performed the action, when available.
  actorUserId    String?  @db.Uuid
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Identity, access control & multi-tenancy
// ---------------------------------------------------------------------------

/// Nonnis application identity. Supabase Auth owns credentials; this owns the
/// application profile. Passwords are never stored here.
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  /// Supabase Auth user id. Nullable until the auth identity is linked.
  supabaseAuthUserId String?    @unique @db.Uuid
  email              String     @unique
  firstName          String?
  lastName           String?
  displayName        String?
  status             UserStatus @default(INVITED)
  metadata           Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  memberships           OrganizationMembership[]
  assignedCases         Case[]                   @relation("CaseAssignedProfessional")
  completedRequirements CaseRequirement[]        @relation("RequirementCompletedBy")
  workflowEvents        WorkflowEvent[]
  auditEvents           AuditEvent[]
  capacityUpdates       ProviderCapacity[]       @relation("CapacityUpdatedBy")

  @@index([status])
  @@map("users")
}

/// A stable, code-identified role. Roles map to permissions; guards resolve
/// permissions rather than hardcoding role names.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  /// Stable machine code, e.g. NONNIS_ADMIN.
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  memberships OrganizationMembership[]

  @@map("roles")
}

/// A stable, code-identified permission. Authorization decisions check
/// permission codes, never role names.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  /// Stable machine code, e.g. cases.read.
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

/// Join table mapping roles to their granted permissions.
model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// A user's membership of an organization, carrying a single role. A user may
/// belong to multiple organizations; membership — not a column on User — is the
/// authoritative access mechanism.
model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  roleId         String           @db.Uuid
  status         MembershipStatus @default(INVITED)
  isPrimary      Boolean          @default(false)
  invitedAt      DateTime?
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([roleId])
  @@index([status])
  @@map("organization_memberships")
}

// ---------------------------------------------------------------------------
// Provider directory (standard operational management — no matching, scoring,
// or compliance workflows). Providers are a Nonnis-managed directory used to
// browse, search and filter for later MANUAL provider selection.
// ---------------------------------------------------------------------------

/// Simple operational status for a provider. Not a compliance/approval state.
enum ProviderStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

/// The kind of area a coverage row describes.
enum CoverageType {
  CITY
  COUNTY
  STATE
  POSTAL_CODE
  RADIUS
}

/// Days of the week for operating hours.
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// Simple current-availability status for a provider (optionally per category).
enum CapacityStatus {
  AVAILABLE
  LIMITED
  UNAVAILABLE
  UNKNOWN
}

/// A provider's operational profile. One-to-one with a PROVIDER Organization,
/// which owns the canonical legal identity; the Provider owns operational,
/// directory-facing detail.
model Provider {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @unique @db.Uuid
  status         ProviderStatus @default(ACTIVE)

  /// Public/display name. Falls back to the organization name when unset.
  displayName String
  description String?

  phone   String?
  email   String?
  website String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String? @default("US")
  timezone     String?

  /// Descriptive eligibility information only (population served, admission
  /// criteria, restrictions). NOT an eligibility engine.
  eligibilityNotes String?
  /// Internal Nonnis notes — never exposed to directory-read (non-manager) users.
  internalNotes    String?

  /// Simple informational credentials as plain metadata. NOT tracked, verified,
  /// or expiry-monitored (the Document & Compliance module is out of scope).
  licenseNumber String?
  licenseType   String?

  /// Public residential directory listing. Nonnis-managed only; every field
  /// defaults OFF so no existing provider is auto-published. Canonical provider
  /// fields (displayName, description, phone, email, website, city, state) are
  /// the public source; only the fields below are listing-specific.
  isResidentialProvider          Boolean   @default(false)
  publicListingEnabled           Boolean   @default(false)
  publicSlug                     String?   @unique
  publicDescription              String?
  publicFeaturedImageUrl         String?
  publicFeaturedImageStoragePath String?
  publicSortOrder                Int?
  publicPublishedAt              DateTime?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services      ProviderService[]
  coverageAreas ProviderCoverageArea[]
  paymentTypes  ProviderPaymentType[]
  languages     ProviderLanguage[]
  hours         ProviderHours[]
  capacity      ProviderCapacity[]
  referrals     Referral[]

  @@index([status])
  @@index([state])
  @@index([city])
  @@index([publicListingEnabled])
  @@map("providers")
}

/// Admin-managed catalog of service categories. `code` mirrors the stable
/// ServiceCategoryCode enum values so historical service requests map cleanly.
model ServiceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providerServices ProviderService[]
  serviceRequests  ServiceRequest[]
  capacityRows     ProviderCapacity[]

  @@index([active])
  @@map("service_categories")
}

/// A service a provider offers, linked to an admin-managed ServiceCategory.
model ProviderService {
  id                String       @id @default(uuid()) @db.Uuid
  providerId        String       @db.Uuid
  serviceCategoryId String       @db.Uuid
  active            Boolean      @default(true)
  description       String?
  levelOfCare       LevelOfCare?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  provider        Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)

  @@unique([providerId, serviceCategoryId])
  @@index([providerId])
  @@index([serviceCategoryId])
  @@map("provider_services")
}

/// A geographic area a provider covers. Plain searchable data — no GIS,
/// distance scoring, or mapping-API integration.
model ProviderCoverageArea {
  id           String       @id @default(uuid()) @db.Uuid
  providerId   String       @db.Uuid
  coverageType CoverageType @default(CITY)
  city         String?
  county       String?
  state        String?
  postalCode   String?
  radiusMiles  Int?
  notes        String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([state])
  @@index([city])
  @@index([postalCode])
  @@map("provider_coverage_areas")
}

/// Admin-managed catalog of accepted payment / insurance types.
model PaymentType {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerPaymentTypes ProviderPaymentType[]

  @@index([active])
  @@map("payment_types")
}

/// Payment/insurance type accepted by a provider.
model ProviderPaymentType {
  id            String   @id @default(uuid()) @db.Uuid
  providerId    String   @db.Uuid
  paymentTypeId String   @db.Uuid
  active        Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider    Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  paymentType PaymentType @relation(fields: [paymentTypeId], references: [id], onDelete: Restrict)

  @@unique([providerId, paymentTypeId])
  @@index([providerId])
  @@index([paymentTypeId])
  @@map("provider_payment_types")
}

/// Admin-managed catalog of languages.
model Language {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerLanguages ProviderLanguage[]

  @@index([active])
  @@map("languages")
}

/// A language a provider supports.
model ProviderLanguage {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @db.Uuid
  languageId String   @db.Uuid
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([providerId, languageId])
  @@index([providerId])
  @@index([languageId])
  @@map("provider_languages")
}

/// Operating hours for a provider, one row per weekday. Not a scheduling engine.
model ProviderHours {
  id         String    @id @default(uuid()) @db.Uuid
  providerId String    @db.Uuid
  dayOfWeek  DayOfWeek
  closed     Boolean   @default(false)
  open24     Boolean   @default(false)
  /// "HH:MM" 24-hour local time. Null when closed or open24.
  opensAt    String?
  closesAt   String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek])
  @@index([providerId])
  @@map("provider_hours")
}

/// Simple current capacity/availability for a provider, optionally scoped to a
/// service category. Updates overwrite the row; history is captured via
/// AuditEvent. No forecasting, sync, scheduling, or analytics.
model ProviderCapacity {
  id                String         @id @default(uuid()) @db.Uuid
  providerId        String         @db.Uuid
  serviceCategoryId String?        @db.Uuid
  status            CapacityStatus @default(UNKNOWN)
  availableCount    Int?
  effectiveDate     DateTime?      @db.Date
  notes             String?
  updatedByUserId   String?        @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  provider        Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  updatedBy       User?            @relation("CapacityUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([providerId, serviceCategoryId])
  @@index([providerId])
  @@index([status])
  @@map("provider_capacity")
}

// ---------------------------------------------------------------------------
// Website form submissions
//
// Additive persistence of PUBLIC Nonnis website form submissions so Nonnis staff
// can review them internally. The website's existing email / PDF / report flow is
// unchanged; this only stores a normalized copy. This is NOT the excluded external
// integration architecture — it is Nonnis's own website connecting to its own
// platform. Never store passwords, SMTP creds, tokens, or uploaded file bytes here.
// ---------------------------------------------------------------------------

/// Manual internal review state for a website form submission.
enum FormSubmissionStatus {
  NEW
  IN_REVIEW
  RESOLVED
  ARCHIVED
}

/// One persisted public website form submission.
model WebsiteFormSubmission {
  id        String @id @default(uuid()) @db.Uuid
  /// The website's human-readable submission reference (PREFIX-YYYYMMDD-XXXXXX).
  /// Also the idempotency key: re-ingesting the same reference is a no-op.
  reference String @unique

  /// Stable machine key for the form, e.g. "hospital_referral".
  formKey    String
  formName   String
  sourcePage String?

  // Promoted, searchable submitter fields (also present inside submittedData).
  submitterName  String?
  submitterEmail String?
  submitterPhone String?

  /// Full normalized submission payload (no secrets, no file bytes).
  submittedData Json

  // Metadata about the website's existing email/report/document flow, when known.
  emailStatus       String?
  reportGenerated   Boolean @default(false)
  documentGenerated Boolean @default(false)
  attachmentsCount  Int     @default(0)

  // Internal review (manual only — no automation).
  status           FormSubmissionStatus @default(NEW)
  reviewedByUserId String?              @db.Uuid
  reviewedAt       DateTime?
  internalNotes    String?

  // Optional manual links (soft references; no auto-creation).
  relatedCaseId     String? @db.Uuid
  relatedProviderId String? @db.Uuid

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([formKey])
  @@index([status])
  @@index([submittedAt])
  @@index([submitterEmail])
  @@map("website_form_submissions")
}

// ---------------------------------------------------------------------------
// Referral workflow (manual provider selection -> provider response -> placement)
//
// Provider selection is entirely MANUAL — staff search/filter the existing
// provider directory and choose. There is no matching/scoring/ranking engine.
// ---------------------------------------------------------------------------

/// Lifecycle of a single referral to one provider.
enum ReferralStatus {
  DRAFT
  SENT
  VIEWED
  INFORMATION_REQUESTED
  CONDITIONALLY_ACCEPTED
  ACCEPTED
  DECLINED
  WITHDRAWN
  CANCELLED
}

/// A discrete response/action recorded against a referral (append-only history).
enum ReferralResponseType {
  INFORMATION_REQUESTED
  INFORMATION_PROVIDED
  CONDITIONALLY_ACCEPTED
  ACCEPTED
  DECLINED
}

/// Structured reason a provider declined a referral.
enum ReferralDeclineReason {
  NO_CAPACITY
  OUTSIDE_COVERAGE
  SERVICE_NOT_OFFERED
  FUNDING_NOT_ACCEPTED
  CLINICAL_NEEDS_UNSUPPORTED
  START_DATE_UNAVAILABLE
  ELIGIBILITY_NOT_MET
  OTHER
}

/// Delivery state of the (basic, manual) transactional referral notification.
enum ReferralNotificationStatus {
  NOT_SENT
  SENT
  FAILED
}

/// Lifecycle of an accepted placement (the accepted service arrangement).
enum PlacementStatus {
  ACCEPTED
  COORDINATING
  SCHEDULED
  STARTED
  UNSUCCESSFUL
  CANCELLED
}

/// Structured reason a scheduled service start did not occur.
enum ServiceStartFailureReason {
  PATIENT_UNAVAILABLE
  PATIENT_DECLINED
  PROVIDER_UNAVAILABLE
  AUTHORIZATION_ISSUE
  SCHEDULE_CHANGED
  OTHER
}

/// A referral of one case service request to one manually selected provider.
model Referral {
  id               String         @id @default(uuid()) @db.Uuid
  /// User-facing reference (REF-<year>-XXXXXX). UUID remains the PK.
  reference        String         @unique
  caseId           String         @db.Uuid
  serviceRequestId String         @db.Uuid
  providerId       String         @db.Uuid
  status           ReferralStatus @default(DRAFT)

  selectedByUserId String?   @db.Uuid
  sentByUserId     String?   @db.Uuid
  sentAt           DateTime?
  viewedAt         DateTime?
  responseDueAt    DateTime?
  lastResponseAt   DateTime?
  withdrawnAt      DateTime?
  withdrawReason   String?

  /// Provider's internal assignee (a User in the provider organization).
  assignedProviderUserId String? @db.Uuid
  coordinationNote       String?

  notificationStatus    ReferralNotificationStatus @default(NOT_SENT)
  notificationSentAt    DateTime?
  notificationLastError String?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case           Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest     @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  provider       Provider           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  responses      ReferralResponse[]
  placement      Placement?
  messages       Message[]

  @@index([caseId])
  @@index([serviceRequestId])
  @@index([providerId])
  @@index([status])
  @@map("referrals")
}

/// Append-only response/history entry for a referral.
model ReferralResponse {
  id                String                 @id @default(uuid()) @db.Uuid
  referralId        String                 @db.Uuid
  type              ReferralResponseType
  actorUserId       String?                @db.Uuid
  message           String?
  declineReason     ReferralDeclineReason?
  conditions        String?
  proposedStartDate DateTime?
  fundingConfirmed  Boolean?
  capacityConfirmed Boolean?
  metadata          Json?
  createdAt         DateTime               @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@map("referral_responses")
}

/// The accepted service arrangement created when a referral is accepted.
model Placement {
  id                 String                     @id @default(uuid()) @db.Uuid
  referralId         String                     @unique @db.Uuid
  status             PlacementStatus            @default(ACCEPTED)
  acceptedAt         DateTime?
  scheduledStartAt   DateTime?
  actualStartAt      DateTime?
  unsuccessfulAt     DateTime?
  unsuccessfulReason ServiceStartFailureReason?
  unsuccessfulNote   String?
  cancelledAt        DateTime?
  metadata           Json?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("placements")
}

// ---------------------------------------------------------------------------
// Manual case tasks & case-linked messaging (all user-driven; no automation).
// ---------------------------------------------------------------------------

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Communication/note visibility. CASE_TEAM = case org + Nonnis; NONNIS_INTERNAL
/// = Nonnis staff only; PROVIDER_REFERRAL = scoped to one referral's provider
/// plus the case/Nonnis side.
enum MessageScope {
  CASE_TEAM
  NONNIS_INTERNAL
  PROVIDER_REFERRAL
}

/// A concrete, manually-created action tied to a case. Overdue is DERIVED at
/// read time (dueAt < now and not completed/cancelled) — never a stored status.
model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  caseId         String       @db.Uuid
  title          String
  description    String?
  priority       TaskPriority @default(NORMAL)
  status         TaskStatus   @default(OPEN)

  assigneeUserId    String?   @db.Uuid
  createdByUserId   String    @db.Uuid
  dueAt             DateTime?
  completedAt       DateTime?
  completedByUserId String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([assigneeUserId])
  @@index([status])
  @@index([organizationId])
  @@map("case_tasks")
}

/// An append-only, case-linked message. PROVIDER_REFERRAL messages carry the
/// referralId they belong to; other scopes leave it null.
model Message {
  id           String       @id @default(uuid()) @db.Uuid
  caseId       String       @db.Uuid
  scope        MessageScope
  referralId   String?      @db.Uuid
  senderUserId String       @db.Uuid
  body         String
  createdAt    DateTime     @default(now())

  case     Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  referral Referral? @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([caseId, scope])
  @@index([referralId])
  @@index([createdAt])
  @@map("case_messages")
}

// ---------------------------------------------------------------------------
// Public website content (CMS)
//
// Nonnis-managed content published to the PUBLIC marketing website: blog
// articles, curated short-form videos, and homepage testimonials. Only
// PUBLISHED/active records are ever exposed by the public read-only API; drafts,
// archived rows, and internal notes are never public. This is a focused CMS for
// Nonnis's current needs — not a generic page-builder or DAM.
// ---------------------------------------------------------------------------

/// Publishing lifecycle for a blog article. Only PUBLISHED is public.
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A written blog/article. `body` holds a safe Markdown subset (rendered without
/// raw-HTML interpretation on the website). Slug is the stable public URL key.
model BlogPost {
  id                       String        @id @default(uuid()) @db.Uuid
  title                    String
  slug                     String        @unique
  excerpt                  String?
  /// Markdown-subset article body (headings, paragraphs, lists, emphasis, links).
  body                     String
  featuredImageUrl         String?
  /// Object path within the managed content bucket, when the image is Nonnis-owned
  /// (enables safe replace/delete). Null for external URLs — never storage-deleted.
  featuredImageStoragePath String?
  category                 String?
  displayAuthor            String?
  metaTitle                String?
  metaDescription          String?
  status                   ContentStatus @default(DRAFT)
  publishedAt              DateTime?
  createdByUserId          String?       @db.Uuid
  updatedByUserId          String?       @db.Uuid
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  shortVideos ShortVideo[]

  @@index([status])
  @@index([publishedAt])
  @@index([category])
  @@map("blog_posts")
}

/// A curated short-form video for the public blog's video strip. Media lives at a
/// URL (local `/assets/...` or an external host); this stores metadata only — no
/// transcoding or upload pipeline. Optionally associated to a BlogPost.
model ShortVideo {
  id                     String    @id @default(uuid()) @db.Uuid
  title                  String
  caption                String?
  videoUrl               String
  /// Managed-bucket object path for the video, when Nonnis-owned (else null).
  videoStoragePath       String?
  posterImageUrl         String?
  /// Managed-bucket object path for the poster, when Nonnis-owned (else null).
  posterImageStoragePath String?
  sourceLabel            String?
  blogPostId             String?   @db.Uuid
  active                 Boolean   @default(true)
  sortOrder              Int       @default(0)
  publishedAt            DateTime?
  createdByUserId        String?   @db.Uuid
  updatedByUserId        String?   @db.Uuid
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  blogPost BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: SetNull)

  @@index([active, sortOrder])
  @@index([blogPostId])
  @@map("short_videos")
}

/// A homepage testimonial. `internalNotes` is Nonnis-only and NEVER exposed by
/// the public API. Attribution fields are optional — an approved testimonial may
/// be intentionally anonymous (quote only).
model Testimonial {
  id              String   @id @default(uuid()) @db.Uuid
  quote           String
  clientName      String?
  clientTitle     String?
  organization    String?
  location        String?
  /// Nonnis-internal only. Never returned by the public API.
  internalNotes   String?
  active          Boolean  @default(true)
  featured        Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdByUserId String?  @db.Uuid
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("testimonials")
}

// ============================================================================
// Communications module (Phase 15A) — a dedicated marketing/outreach contact
// database. Intentionally SEPARATE from User/Patient/Provider identities; it
// never references Case/Patient records (PHI boundary). Brevo/Twilio are future
// transport providers only and never own this data model.
// ============================================================================

enum CommunicationContactSource {
  MANUAL
  PASTE_IMPORT
  CSV_IMPORT
  TXT_IMPORT
}

enum CommunicationContactStatus {
  ACTIVE
  ARCHIVED
}

enum CommunicationChannel {
  EMAIL
  SMS
}

enum CommunicationConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum CommunicationSuppressionReason {
  USER_OPT_OUT
  ADMIN_BLOCK
  HARD_BOUNCE
  SPAM_COMPLAINT
  INVALID_ADDRESS
}

enum CommunicationConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum CommunicationMessageDirection {
  OUTBOUND
  INBOUND
}

enum CommunicationMessageStatus {
  QUEUED
  PROCESSING
  ACCEPTED
  SENT
  DELIVERED
  UNDELIVERED
  BOUNCED
  FAILED
  DELIVERY_UNKNOWN
  RECEIVED
}

model CommunicationContact {
  id String @id @default(uuid()) @db.Uuid

  firstName String?
  lastName  String?

  email           String?
  normalizedEmail String? @unique

  phone               String?
  normalizedPhoneE164 String? @unique

  organizationName String?

  /// Opaque, random, per-contact token backing the public email unsubscribe link
  /// (never exposes the contact id or email in the URL). Generated at send time.
  unsubscribeToken String? @unique

  source CommunicationContactSource @default(MANUAL)
  status CommunicationContactStatus @default(ACTIVE)

  createdByUserId String?  @db.Uuid
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  preferences     ContactChannelPreference[]
  listMemberships CommunicationListMember[]
  tagAssignments  CommunicationContactTag[]
  conversations   CommunicationConversation[]

  @@index([status])
  @@index([organizationName])
  @@map("communication_contacts")
}

model ContactChannelPreference {
  id              String                     @id @default(uuid()) @db.Uuid
  contactId       String                     @db.Uuid
  channel         CommunicationChannel
  consentStatus   CommunicationConsentStatus @default(UNKNOWN)
  consentSource   String?
  consentAt       DateTime?
  optOutAt        DateTime?
  updatedByUserId String?                    @db.Uuid
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  contact CommunicationContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, channel])
  @@index([channel, consentStatus])
  @@map("contact_channel_preferences")
}

model CommunicationList {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  active          Boolean  @default(true)
  createdByUserId String?  @db.Uuid
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members CommunicationListMember[]

  @@index([active])
  @@map("communication_lists")
}

model CommunicationListMember {
  id            String   @id @default(uuid()) @db.Uuid
  listId        String   @db.Uuid
  contactId     String   @db.Uuid
  addedByUserId String?  @db.Uuid
  addedAt       DateTime @default(now())

  list    CommunicationList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact CommunicationContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@index([contactId])
  @@map("communication_list_members")
}

model CommunicationTag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())

  assignments CommunicationContactTag[]

  @@map("communication_tags")
}

model CommunicationContactTag {
  id        String   @id @default(uuid()) @db.Uuid
  contactId String   @db.Uuid
  tagId     String   @db.Uuid
  createdAt DateTime @default(now())

  contact CommunicationContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     CommunicationTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([tagId])
  @@map("communication_contact_tags")
}

model CommunicationSuppression {
  id                String                         @id @default(uuid()) @db.Uuid
  channel           CommunicationChannel
  normalizedAddress String
  reason            CommunicationSuppressionReason
  active            Boolean                        @default(true)
  source            String?
  createdByUserId   String?                        @db.Uuid
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  @@unique([channel, normalizedAddress])
  @@index([active])
  @@map("communication_suppressions")
}

model CommunicationImportBatch {
  id               String                     @id @default(uuid()) @db.Uuid
  sourceType       CommunicationContactSource
  originalFilename String?
  totalRows        Int
  importedCount    Int                        @default(0)
  duplicateCount   Int                        @default(0)
  invalidCount     Int                        @default(0)
  conflictCount    Int                        @default(0)
  suppressedCount  Int                        @default(0)
  createdByUserId  String?                    @db.Uuid
  createdAt        DateTime                   @default(now())

  @@index([createdAt])
  @@map("communication_import_batches")
}

model CommunicationConversation {
  id            String                          @id @default(uuid()) @db.Uuid
  contactId     String                          @db.Uuid
  channel       CommunicationChannel
  status        CommunicationConversationStatus @default(OPEN)
  subject       String?
  lastMessageAt DateTime?

  /// High-entropy opaque token backing the conversation-specific inbound reply
  /// address (reply-<token>@<domain>). Stable per conversation; never a raw id.
  threadToken String? @unique

  /// Cheap Inbox derivation without re-parsing bodies. lastInboundAt tracks only
  /// human (non auto-submitted) inbound; needsReply = lastInboundAt > lastOutboundAt.
  lastInboundAt   DateTime?
  lastOutboundAt  DateTime?
  latestDirection CommunicationMessageDirection?
  previewText     String?
  archivedAt      DateTime?

  /// Optional origin campaign (for the "Started from campaign" link). SetNull so
  /// deleting a campaign never destroys conversation history.
  originCampaignId String? @db.Uuid

  /// SMS (15D): the Nonnis/Twilio business number this conversation runs through.
  /// Kept per-conversation so a Messaging Service holding several senders stays safe.
  businessNumber      String?
  originSmsCampaignId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact           CommunicationContact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  originCampaign    CommunicationEmailCampaign?          @relation(fields: [originCampaignId], references: [id], onDelete: SetNull)
  originSmsCampaign CommunicationSmsCampaign?            @relation(fields: [originSmsCampaignId], references: [id], onDelete: SetNull)
  messages          CommunicationMessage[]
  readStates        CommunicationConversationReadState[]

  @@index([contactId])
  @@index([channel, status])
  @@index([channel, status, lastMessageAt])
  @@index([channel, contactId, businessNumber])
  @@map("communication_conversations")
}

model CommunicationMessage {
  id             String                        @id @default(uuid()) @db.Uuid
  conversationId String                        @db.Uuid
  channel        CommunicationChannel
  direction      CommunicationMessageDirection
  status         CommunicationMessageStatus    @default(QUEUED)

  subject     String?
  textBody    String?
  /// Sanitized, email-safe HTML only (never raw untrusted inbound HTML).
  htmlBody    String?
  previewText String?

  fromAddress    String?
  fromName       String?
  toAddress      String?
  replyToAddress String?

  /// RFC/Internet Message-ID (the <...@...> header). Distinct from the provider's
  /// API message id below. Used to satisfy In-Reply-To on future replies.
  messageId  String?
  inReplyTo  String?
  /// Space-separated RFC References chain (bounded length).
  references String?

  /// Provider transactional API id (Brevo messageId) — NOT the RFC Message-ID.
  providerMessageId String?
  /// Provider inbound identity for idempotent inbound ingestion (unique).
  providerInboundId String? @unique
  /// True for detected auto-responders (Auto-Submitted header) — never sets needsReply.
  autoSubmitted     Boolean @default(false)

  /// SMS (15D). encoding/segmentCount are OUR estimate; providerSegmentCount is what
  /// the provider actually reported (NumSegments) when available.
  encoding             SmsEncoding?
  segmentCount         Int?
  providerSegmentCount Int?
  /// Provider-authoritative opt-out classification for an inbound SMS (Twilio
  /// Advanced Opt-Out `OptOutType`). Never sets needsReply.
  smsOptOutType        SmsOptOutType?

  // Direct-reply outbox delivery bookkeeping (campaign sends use the recipient row).
  attemptCount         Int       @default(0)
  claimToken           String?
  leaseExpiresAt       DateTime?
  nextAttemptAt        DateTime?
  /// Set immediately BEFORE the provider call — see the campaign recipient fields.
  dispatchedAt         DateTime?
  /// Client-supplied key making a direct reply queue request idempotent, so a
  /// double-click or a browser/network retry can never create two outbound messages.
  idempotencyKey       String?   @unique
  lastErrorCode        String?
  lastErrorMessageSafe String?

  sentAt        DateTime?
  deliveredAt   DateTime?
  undeliveredAt DateTime?
  receivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  conversation CommunicationConversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  CommunicationMessageAttachment[]

  @@index([conversationId])
  @@index([providerMessageId])
  @@index([direction, status])
  /// Drives expired-lease recovery + delivery-operations scans.
  @@index([channel, direction, status])
  @@map("communication_messages")
}

model CommunicationConversationReadState {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  lastReadAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("communication_conversation_read_states")
}

enum CommunicationInboundReviewReason {
  NO_TOKEN
  UNKNOWN_TOKEN
  MALFORMED_ADDRESS
  THREAD_SENDER_MISMATCH
  HEADER_SENDER_MISMATCH
  UNRESOLVED
  // SMS (15D)
  UNKNOWN_PHONE
  PHONE_CONFLICT
  UNKNOWN_BUSINESS_NUMBER
  INVALID_PROVIDER_PAYLOAD
}

enum CommunicationInboundReviewStatus {
  PENDING
  LINKED
  DISMISSED
}

/// Safe quarantine for inbound email that failed correlation or a sender-identity
/// check. Never auto-creates contacts; staff link or dismiss it. Only the minimal
/// fields for review are stored — never the full raw provider payload.
model CommunicationInboundEmailReview {
  id       String @id @default(uuid()) @db.Uuid
  provider String

  /// Which channel the quarantined message arrived on. One review queue serves both
  /// EMAIL (15C) and SMS (15D); `fromEmail`/`toAddress` hold that channel's address
  /// form (an email address, or an E.164 phone number for SMS).
  channel CommunicationChannel @default(EMAIL)

  /// Provider inbound identity (idempotency for the quarantine too).
  providerInboundId String? @unique

  fromEmail String
  fromName  String?
  toAddress String?
  subject   String?

  textBody          String?
  sanitizedHtmlBody String?
  previewText       String?

  internetMessageId String?
  inReplyTo         String?
  references        String?

  receivedAt DateTime?

  reason CommunicationInboundReviewReason
  status CommunicationInboundReviewStatus @default(PENDING)

  linkedConversationId String?   @db.Uuid
  reviewedByUserId     String?   @db.Uuid
  reviewedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([channel, status])
  @@map("communication_inbound_email_reviews")
}

/// Communication email attachments (inbound + outbound). Binary lives in a PRIVATE
/// Supabase Storage bucket — only the storage path is kept here, never public URLs.
model CommunicationMessageAttachment {
  id        String @id @default(uuid()) @db.Uuid
  messageId String @db.Uuid

  fileName  String
  mimeType  String
  sizeBytes Int

  /// Object path inside the private communications bucket (never returned publicly).
  storagePath String

  providerAttachmentId String?
  contentId            String?

  createdAt DateTime @default(now())

  message CommunicationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("communication_message_attachments")
}

// ============================================================================
// Communications Phase 15B — email templates, campaigns, recipient snapshots,
// Postgres-backed delivery queue, normalized provider events, unsubscribe.
// Transport stays provider-independent (mock / Brevo behind EmailTransport).
// ============================================================================

enum CommunicationEmailTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CommunicationEmailCampaignStatus {
  DRAFT
  READY
  QUEUED
  SENDING
  COMPLETED
  PARTIALLY_FAILED
  CANCELLED
}

enum CommunicationEmailRecipientStatus {
  EXCLUDED
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  BOUNCED
  FAILED
  UNSUBSCRIBED
  CANCELLED
  DELIVERY_UNKNOWN
}

enum NormalizedEmailEvent {
  ACCEPTED
  DELIVERED
  BOUNCED_HARD
  BOUNCED_SOFT
  BLOCKED
  COMPLAINT
  UNSUBSCRIBED
  FAILED
}

model CommunicationEmailTemplate {
  id               String                           @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  subjectDefault   String?
  preheaderDefault String?
  /// Structured, versioned block design ({ version, settings, blocks }). The
  /// backend compiler is authoritative — frontend HTML is never trusted.
  designJson       Json
  compiledHtml     String
  compiledText     String
  status           CommunicationEmailTemplateStatus @default(DRAFT)
  createdByUserId  String?                          @db.Uuid
  updatedByUserId  String?                          @db.Uuid
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  campaigns CommunicationEmailCampaign[]

  @@index([status])
  @@map("communication_email_templates")
}

model CommunicationEmailCampaign {
  id         String                           @id @default(uuid()) @db.Uuid
  name       String
  status     CommunicationEmailCampaignStatus @default(DRAFT)
  templateId String?                          @db.Uuid

  /// Immutable content snapshot captured at queue time.
  subjectSnapshot   String?
  preheaderSnapshot String?
  htmlSnapshot      String?
  textSnapshot      String?
  senderEmail       String?
  senderName        String?

  /// { listIds: string[], contactIds: string[] }
  audienceConfig         Json
  eligibleRecipientCount Int  @default(0)
  excludedRecipientCount Int  @default(0)

  queuedAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdByUserId String?  @db.Uuid
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template            CommunicationEmailTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients          CommunicationEmailCampaignRecipient[]
  originConversations CommunicationConversation[]

  @@index([status])
  @@map("communication_email_campaigns")
}

model CommunicationEmailCampaignRecipient {
  id         String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  /// Soft reference (no FK relation) so history survives contact deletion.
  contactId  String @db.Uuid

  emailSnapshot            String
  firstNameSnapshot        String?
  lastNameSnapshot         String?
  organizationNameSnapshot String?

  exclusionReason String?
  deliveryStatus  CommunicationEmailRecipientStatus @default(QUEUED)

  internalMessageId String  @unique
  threadToken       String  @unique
  providerMessageId String?
  conversationId    String? @db.Uuid
  messageId         String? @db.Uuid

  attemptCount   Int       @default(0)
  claimToken     String?
  leaseExpiresAt DateTime?

  queuedAt       DateTime?
  processingAt   DateTime?
  /// Set immediately BEFORE the provider call. If a lease expires with this null the
  /// worker died before dispatching, so the row is safe to re-queue; if it is set we
  /// cannot know whether the provider accepted, so it becomes DELIVERY_UNKNOWN.
  dispatchedAt   DateTime?
  sentAt         DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  bouncedAt      DateTime?
  unsubscribedAt DateTime?
  cancelledAt    DateTime?

  lastErrorCode        String?
  lastErrorMessageSafe String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign CommunicationEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, deliveryStatus])
  @@index([deliveryStatus])
  @@index([providerMessageId])
  /// Drives expired-lease recovery scans.
  @@index([deliveryStatus, leaseExpiresAt])
  @@map("communication_email_campaign_recipients")
}

model CommunicationEmailEvent {
  id                String               @id @default(uuid()) @db.Uuid
  recipientId       String?              @db.Uuid
  providerMessageId String?
  normalizedType    NormalizedEmailEvent
  /// Stable dedup key (provider message id + event type + occurrence) so retried
  /// webhooks are idempotent. Raw provider payloads are NOT stored.
  dedupKey          String               @unique
  occurredAt        DateTime?
  createdAt         DateTime             @default(now())

  @@index([providerMessageId])
  @@map("communication_email_events")
}

// ============================================================================
// Communications Phase 15D — SMS templates, campaigns, recipient snapshots and
// two-way SMS. Transport stays provider-independent (mock / Twilio behind the
// SmsTransport port). Conversations/messages reuse the 15A/15C models with
// channel = SMS; there is no second messaging system.
// ============================================================================

enum SmsEncoding {
  GSM7
  UCS2
}

/// Provider-authoritative inbound classification (Twilio Advanced Opt-Out
/// `OptOutType`). Twilio has already sent its own confirmation reply when this
/// is present — the CRM must never send a duplicate.
enum SmsOptOutType {
  STOP
  START
  HELP
}

enum CommunicationSmsTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CommunicationSmsCampaignStatus {
  DRAFT
  READY
  QUEUED
  SENDING
  COMPLETED
  PARTIALLY_FAILED
  CANCELLED
}

/// Provider-neutral SMS delivery states. Twilio status strings are normalized
/// into these by the adapter/status service — never leaked into business logic.
enum CommunicationSmsRecipientStatus {
  EXCLUDED
  QUEUED
  PROCESSING
  ACCEPTED
  SENT
  DELIVERED
  UNDELIVERED
  FAILED
  CANCELLED
  DELIVERY_UNKNOWN
}

/// A reusable plain-text SMS template. No HTML, no Markdown, no page builder —
/// SMS is text. Merge fields use the same safe contact allow-list as email.
model CommunicationSmsTemplate {
  id          String                         @id @default(uuid()) @db.Uuid
  name        String
  description String?
  body        String
  status      CommunicationSmsTemplateStatus @default(DRAFT)

  createdByUserId String?  @db.Uuid
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaigns CommunicationSmsCampaign[]

  @@index([status])
  @@map("communication_sms_templates")
}

model CommunicationSmsCampaign {
  id         String                         @id @default(uuid()) @db.Uuid
  name       String
  status     CommunicationSmsCampaignStatus @default(DRAFT)
  templateId String?                        @db.Uuid

  /// Immutable message snapshot captured at queue time (pre-merge template body).
  bodySnapshot String?

  /// { listIds: string[], contactIds: string[] }
  audienceConfig Json

  eligibleRecipientCount Int @default(0)
  excludedRecipientCount Int @default(0)
  /// Aggregate ESTIMATES computed from per-recipient rendered bodies. Segment
  /// counts are an estimate, never an invoice — carrier/provider billing may differ.
  estimatedSegmentCount  Int @default(0)
  gsm7RecipientCount     Int @default(0)
  ucs2RecipientCount     Int @default(0)
  multiSegmentCount      Int @default(0)
  longestBodyChars       Int @default(0)

  queuedAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdByUserId String?  @db.Uuid
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template            CommunicationSmsTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients          CommunicationSmsCampaignRecipient[]
  originConversations CommunicationConversation[]

  @@index([status])
  @@map("communication_sms_campaigns")
}

model CommunicationSmsCampaignRecipient {
  id         String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  /// Soft reference (no FK relation) so history survives contact deletion.
  contactId  String @db.Uuid

  /// Snapshots taken at queue time — history never depends on the contact changing.
  phoneSnapshot            String
  firstNameSnapshot        String?
  lastNameSnapshot         String?
  organizationNameSnapshot String?
  /// The fully merge-rendered message for THIS recipient.
  bodySnapshot             String
  encodingSnapshot         SmsEncoding
  estimatedSegmentCount    Int         @default(1)

  exclusionReason String?
  deliveryStatus  CommunicationSmsRecipientStatus @default(QUEUED)

  internalMessageId    String  @unique
  providerMessageId    String?
  /// The sender the provider actually used (a Messaging Service may pick it).
  actualFromNumber     String?
  /// Provider-reported segment count (Twilio NumSegments) when available.
  providerSegmentCount Int?
  conversationId       String? @db.Uuid
  messageId            String? @db.Uuid

  attemptCount   Int       @default(0)
  claimToken     String?
  leaseExpiresAt DateTime?

  queuedAt      DateTime?
  processingAt  DateTime?
  /// Set immediately BEFORE the provider call — see the email recipient field.
  dispatchedAt  DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?
  undeliveredAt DateTime?
  failedAt      DateTime?
  cancelledAt   DateTime?

  lastErrorCode        String?
  lastErrorMessageSafe String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign CommunicationSmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, deliveryStatus])
  @@index([deliveryStatus])
  @@index([providerMessageId])
  /// Drives expired-lease recovery scans.
  @@index([deliveryStatus, leaseExpiresAt])
  @@map("communication_sms_campaign_recipients")
}
