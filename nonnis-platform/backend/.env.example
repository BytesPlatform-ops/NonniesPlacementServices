# Nonnis Platform — backend environment (copy to `.env` and fill in).
# NEVER commit a real .env — it is gitignored. Replace every [PLACEHOLDER].

# --- Supabase PostgreSQL (Prisma) ---
# Runtime queries: shared TRANSACTION-mode pooler (pgbouncer, port 6543).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations: shared SESSION-mode pooler (direct, port 5432). Used by `directUrl`.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Alternative (IPv6 / paid IPv4 add-on): dedicated pooler direct to Postgres.
# DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgres://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- API ---
# Port the API listens on (keep off the public website's port).
PORT=4000

# Allowed CORS origin for the platform frontend.
FRONTEND_URL="http://localhost:3001"

# --- Supabase Auth (backend) ---
# Project URL and anon key are safe/public. The SERVICE ROLE KEY is a SECRET —
# backend only, never sent to the frontend, never logged, never committed.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"

# ---------------------------------------------------------------------------
# Communications module (email). Everything defaults to MOCK — no live keys
# are needed for development, tests, or builds. Never commit real secrets.
# ---------------------------------------------------------------------------
# Outbound email (15B): "mock" (default) or "brevo".
COMMUNICATIONS_EMAIL_PROVIDER="mock"
# Brevo transactional email (only when provider=brevo). API key is a SECRET.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Nonni's Placement"
# Public marketing site + backend base URLs (unsubscribe + List-Unsubscribe).
COMMUNICATIONS_PUBLIC_SITE_URL="http://localhost:3000"
COMMUNICATIONS_API_URL="http://localhost:4000"
# Secret guarding the delivery-event webhook (Brevo webhooks are not signed).
COMMUNICATIONS_WEBHOOK_SECRET=""
# Delivery dispatcher tuning.
EMAIL_DISPATCH_ENABLED="true"
EMAIL_DISPATCH_BATCH_SIZE="25"
EMAIL_DISPATCH_CONCURRENCY="5"
EMAIL_DISPATCH_POLL_MS="3000"
# Inbound email / replies (15C): "mock" (default) or "brevo".
COMMUNICATIONS_INBOUND_EMAIL_PROVIDER="mock"
# Dedicated inbound reply (sub)domain. Mock default: reply.mock.local
COMMUNICATIONS_INBOUND_EMAIL_DOMAIN="reply.mock.local"
# High-entropy secret guarding the inbound-content webhook (required for brevo).
COMMUNICATIONS_INBOUND_EMAIL_SECRET=""
COMMUNICATIONS_INBOUND_MAX_BODY_BYTES="524288"
COMMUNICATIONS_INBOUND_MAX_ATTACHMENT_BYTES="10485760"
COMMUNICATIONS_INBOUND_MAX_ATTACHMENTS="5"
