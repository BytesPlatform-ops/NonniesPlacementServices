# Nonnis Platform — backend environment (copy to `.env` and fill in).
# NEVER commit a real .env — it is gitignored.

# PostgreSQL connection string used by Prisma.
# Example: postgresql://USER:PASSWORD@localhost:5432/nonnis_platform?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nonnis_platform?schema=public"

# Port the API listens on (keep off the public website's port).
PORT=4000

# Allowed CORS origin for the platform frontend.
FRONTEND_URL="http://localhost:3001"
