{
  "name": "nonnis-platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Nonnis Digital Optimization Platform \u2014 backend API (modular monolith)",
  "scripts": {
    "build": "prisma generate && nest build",
    "postinstall": "prisma generate",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "bootstrap:admin": "node --env-file=.env -r ts-node/register src/scripts/bootstrap-admin.ts",
    "content:seed-media": "node --env-file=.env -r ts-node/register src/scripts/seed-content-media.ts",
    "seed:public-directory-demo": "node --env-file=.env -r ts-node/register src/scripts/seed-public-directory-demo.ts",
    "seed:communications-demo": "node --env-file=.env -r ts-node/register src/scripts/seed-communications-demo.ts",
    "communications:simulate-email-reply": "node --env-file=.env -r ts-node/register src/scripts/simulate-email-reply.ts",
    "communications:simulate-sms": "node --env-file=.env -r ts-node/register src/scripts/simulate-sms.ts",
    "dev:auth-account": "node --env-file=.env -r ts-node/register src/scripts/dev-auth-account.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "@supabase/supabase-js": "^2.112.4",
    "@types/sanitize-html": "^2.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^7.0.2",
    "libphonenumber-js": "^1.13.12",
    "mjml": "^4.18.0",
    "nodemailer": "^9.0.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.12.1",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
