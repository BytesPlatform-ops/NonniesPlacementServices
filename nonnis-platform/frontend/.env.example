# Nonnis Platform — frontend local environment (copy to `.env.local`).

# Base URL of the platform backend API (no trailing slash).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Public marketing website origin, used by the provider "View on website" link.
# Same variable the website app uses for its own canonical origin. Optional:
# unset falls back to localhost:3000 in development and to the production
# domain in a production build. Set it explicitly on every deployment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase public (client-safe) configuration. NEVER put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
