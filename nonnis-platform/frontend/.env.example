# Nonnis Platform — frontend local environment (copy to `.env.local`).

# Base URL of the platform backend API (no trailing slash).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Supabase public (client-safe) configuration. NEVER put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
